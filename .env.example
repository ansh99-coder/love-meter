# ============================================================
# Love Meter ❤️ — Environment Configuration
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
# Set to "true" when deploying behind Nginx / Cloudflare / Vercel
TRUST_PROXY=false
# Comma-separated allowed origins, or * for all
CORS_ORIGIN=*

# --- Firebase Admin SDK (server-side) ---
# Option A: Inline service account credentials
FIREBASE_PROJECT_ID=love-meter-aa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@love-meter-aa.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Option B: Path to a downloaded service-account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/service-account.json

# --- Firebase Web SDK (client-side admin login) ---
FIREBASE_API_KEY=AIzaSyAUFVPRKocKKHbSrmxvop_Psqs0YryZ-2M
FIREBASE_AUTH_DOMAIN=love-meter-aa.firebaseapp.com
FIREBASE_STORAGE_BUCKET=love-meter-aa.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=427844763870
FIREBASE_APP_ID=1:427844763870:web:2a8c65c277749c38ef424f
FIREBASE_MEASUREMENT_ID=G-RYTCEW6QDJ

# --- Admin Access Control ---
# Comma-separated list of emails allowed to access the hidden admin dashboard
ADMIN_EMAILS=your-admin@example.com
# Single email (fallback)
ADMIN_EMAIL=your-admin@example.com
# Auto logout after inactivity (milliseconds). Default: 10 minutes
ADMIN_IDLE_TIMEOUT_MS=600000

# --- Security ---
# Salt used to one-way hash IP addresses (never store raw IPs)
IP_HASH_SALT=change-this-to-a-long-random-string

